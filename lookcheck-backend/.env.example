# Anthropic Claude API key - powers photo analysis, link parsing, and outfit generation
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenWeatherMap API key - powers live weather lookups
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Optional - port to run the Flask server on (defaults to 8000)
PORT=8000
