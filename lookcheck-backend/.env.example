# ---------------------------------------------------------------------------
# LookCheck AI - backend configuration
#
# Copy to .env and fill in what you need. Everything has a working default,
# so the app boots and every endpoint responds even with an empty file.
# ---------------------------------------------------------------------------

# Runtime environment: development | production
APP_ENV=development

# Port for the local dev server
PORT=8000

# Secret used to sign JWT access tokens.
# REQUIRED in production - the app refuses to start without it.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# How long an access token stays valid (days)
JWT_EXPIRY_DAYS=30

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default, local development):
#   sqlite:///lookcheck.db
# PostgreSQL (production, e.g. a free Neon / Supabase instance):
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///lookcheck.db

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# mock      - deterministic fake responses, no network, no cost (default)
# gemini    - Google AI Studio, has a free tier
# anthropic - Claude, paid
# Leave empty to auto-detect: gemini if GEMINI_API_KEY is set, else anthropic
# if ANTHROPIC_API_KEY is set, else mock.
AI_PROVIDER=

# Google AI Studio key - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic key - https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Weather provider
# ---------------------------------------------------------------------------
# open-meteo   - free, no API key required (default)
# openweather  - requires OPENWEATHER_API_KEY
WEATHER_PROVIDER=open-meteo
OPENWEATHER_API_KEY=

# ---------------------------------------------------------------------------
# Limits (cost control - important once a real AI key is configured)
# ---------------------------------------------------------------------------
# Max outfit generations per user per day
MAX_OUTFITS_PER_DAY=10
# Max AI analysis calls (photo + link) per user per hour
MAX_ANALYSIS_PER_HOUR=20
# Max wardrobe items per user
MAX_WARDROBE_ITEMS=300
# Max upload size for clothing photos, in megabytes
MAX_UPLOAD_MB=8

# Comma-separated allowed CORS origins. "*" is fine for a mobile-only client.
CORS_ORIGINS=*
